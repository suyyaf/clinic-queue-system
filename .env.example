# Supabase — Session pooler (port 5432) — used by the running app
# Supabase Dashboard → Settings → Database → Connection string → Session pooler
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Supabase — Direct connection — used by prisma migrate only
# Supabase Dashboard → Settings → Database → Connection string → URI
DIRECT_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-random-secret-here"

# Your deployed URL (use http://localhost:3000 for local dev)
NEXTAUTH_URL="https://your-app.vercel.app"

# Optional: Twilio SMS (leave blank to use console mock)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
